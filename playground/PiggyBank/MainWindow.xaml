<Window x:Class="Playground.PiggyBank.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="存钱罐 · 金币物理测试" Width="1040" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#1A1F24">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="10,8,10,4">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="点击生成 · 贴底/贴已固定币 + 位置窗静止 → 固定"
                           Foreground="#C8D0D8" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Content="扔进罐" Width="88" Height="26" Click="ThrowIntoJar_Click" Margin="0,0,8,0"/>
                <Button Content="清空" Width="64" Height="26" Click="Clear_Click" Margin="0,0,8,0"/>
                <Button Content="保存参数" Width="72" Height="26" Click="SaveParams_Click" Margin="0,0,12,0"
                        ToolTip="写入 piggybank-settings.json"/>
                <TextBlock x:Name="StatusText" Foreground="#8A949E" VerticalAlignment="Center"/>
            </StackPanel>
            <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                    <TextBlock Text="四周放大px" Foreground="#A8B0B8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="PadPxBox" Width="40" Height="24"
                             VerticalContentAlignment="Center" TextChanged="Param_TextChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                    <TextBlock Text="弹性" Foreground="#A8B0B8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="RestitutionBox" Width="48" Height="24"
                             VerticalContentAlignment="Center" TextChanged="Param_TextChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                    <TextBlock Text="静止窗秒" Foreground="#A8B0B8" VerticalAlignment="Center" Margin="0,0,4,0"
                               ToolTip="位置窗时长；窗内位移/转角峰峰值够小视为静止"/>
                    <TextBox x:Name="StillSecBox" Width="48" Height="24"
                             VerticalContentAlignment="Center" TextChanged="Param_TextChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                    <TextBlock Text="抖动px" Foreground="#A8B0B8" VerticalAlignment="Center" Margin="0,0,4,0"
                               ToolTip="位置窗内允许的位移峰峰值（像素）"/>
                    <TextBox x:Name="JitterPosBox" Width="48" Height="24"
                             VerticalContentAlignment="Center" TextChanged="Param_TextChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                    <TextBlock Text="抖动角rad" Foreground="#A8B0B8" VerticalAlignment="Center" Margin="0,0,4,0"
                               ToolTip="位置窗内允许的转角峰峰值（弧度）"/>
                    <TextBox x:Name="JitterAngBox" Width="48" Height="24"
                             VerticalContentAlignment="Center" TextChanged="Param_TextChanged"/>
                </StackPanel>
            </WrapPanel>
            <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                    <TextBlock Text="Baumgarte" Foreground="#A8B0B8" VerticalAlignment="Center" Margin="0,0,4,0"
                               ToolTip="位置校正比例。Aether 2.2 为引擎常量，改值会写入配置供迁移，当前进程不生效"/>
                    <TextBox x:Name="BaumgarteBox" Width="48" Height="24"
                             VerticalContentAlignment="Center" TextChanged="Param_TextChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                    <TextBlock Text="LinearSlop" Foreground="#A8B0B8" VerticalAlignment="Center" Margin="0,0,4,0"
                               ToolTip="穿透容差。Aether 2.2 为引擎常量，仅持久化"/>
                    <TextBox x:Name="LinearSlopBox" Width="56" Height="24"
                             VerticalContentAlignment="Center" TextChanged="Param_TextChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                    <TextBlock Text="MaxLinCorr" Foreground="#A8B0B8" VerticalAlignment="Center" Margin="0,0,4,0"
                               ToolTip="单步最大位置校正。Aether 2.2 为引擎常量，仅持久化"/>
                    <TextBox x:Name="MaxLinCorrBox" Width="48" Height="24"
                             VerticalContentAlignment="Center" TextChanged="Param_TextChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                    <TextBlock Text="PosIter" Foreground="#A8B0B8" VerticalAlignment="Center" Margin="0,0,4,0"
                               ToolTip="位置迭代次数"/>
                    <TextBox x:Name="PosIterBox" Width="40" Height="24"
                             VerticalContentAlignment="Center" TextChanged="Param_TextChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                    <TextBlock Text="VelIter" Foreground="#A8B0B8" VerticalAlignment="Center" Margin="0,0,4,0"
                               ToolTip="速度迭代次数"/>
                    <TextBox x:Name="VelIterBox" Width="40" Height="24"
                             VerticalContentAlignment="Center" TextChanged="Param_TextChanged"/>
                </StackPanel>
            </WrapPanel>
        </StackPanel>
        <Border Margin="10,0,10,10" BorderBrush="#3A4450" BorderThickness="1" Background="#12161A"
                ClipToBounds="True">
            <Canvas x:Name="Stage" Background="Transparent"
                    MouseLeftButtonDown="Stage_MouseLeftButtonDown"
                    SizeChanged="Stage_SizeChanged"/>
        </Border>
    </DockPanel>
</Window>
