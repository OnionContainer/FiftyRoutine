<Window x:Class="PersonalManagement.Desktop.WishEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加愿望" Height="320" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="名称"/>
        <TextBox x:Name="TitleBox" Margin="0,4,0,8"/>
        <TextBlock Text="所需额度"/>
        <TextBox x:Name="CostBox" Text="1" Margin="0,4,0,8"/>
        <TextBlock Text="缩略图"/>
        <DockPanel Margin="0,4,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="重新截取…" Click="RecropThumb_Click" Margin="0,0,8,0"/>
                <Button Content="浏览…" Click="PickThumb_Click"/>
            </StackPanel>
            <Image x:Name="ThumbPreview" Height="48" Stretch="Uniform" HorizontalAlignment="Left"/>
        </DockPanel>
        <CheckBox x:Name="ArchivedBox" Content="已归档" Margin="0,4,0,12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" Click="Cancel_Click"/>
            <Button x:Name="OkButton" Content="添加" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
