<UserControl x:Class="PersonalManagement.Desktop.GadgetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="小玩意"
                   FontSize="{DynamicResource FontSizeTitle}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,12"/>
        <TextBlock DockPanel.Dock="Top"
                   Text="一些有的没的小功能。当前：镜像文字。"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,0,0,16"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="镜像文字" FontWeight="SemiBold" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <DockPanel LastChildFill="False">
                    <TextBox x:Name="MirrorInput" DockPanel.Dock="Left"
                             Width="220" Height="24" MinHeight="24"
                             VerticalContentAlignment="Center" Padding="2,0"
                             Margin="0,0,8,0" TextChanged="MirrorInput_TextChanged"
                             ToolTip="输入文字；左侧预览为「？！」+ 输入内容，右侧为其水平镜像"/>
                    <Border DockPanel.Dock="Left" Margin="0,0,8,0"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" Background="White"
                            MinWidth="80" Height="24" MaxHeight="24"
                            VerticalAlignment="Center" ClipToBounds="True">
                        <Image x:Name="MirrorPreview" Stretch="Uniform"
                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                    <Button DockPanel.Dock="Left" Content="复制" Width="48" Height="24"
                            Padding="0" VerticalAlignment="Center" Click="MirrorCopy_Click"
                            Margin="0,0,8,0" ToolTip="把预览小图复制到剪贴板"/>
                    <TextBlock DockPanel.Dock="Left" Text="左留白" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0"/>
                    <TextBox x:Name="MirrorPadLeft" DockPanel.Dock="Left"
                             Width="36" Height="24" MinHeight="24" Text="1"
                             VerticalContentAlignment="Center" Padding="2,0"
                             Margin="0,0,8,0" TextChanged="MirrorPad_TextChanged"
                             ToolTip="第一步渲染图左侧留白像素"/>
                    <TextBlock DockPanel.Dock="Left" Text="右留白" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0"/>
                    <TextBox x:Name="MirrorPadRight" DockPanel.Dock="Left"
                             Width="36" Height="24" MinHeight="24" Text="1"
                             VerticalContentAlignment="Center" Padding="2,0"
                             TextChanged="MirrorPad_TextChanged"
                             ToolTip="第一步渲染图右侧留白像素"/>
                </DockPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
