<UserControl x:Class="PersonalManagement.Desktop.SchedulePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PersonalManagement.Desktop">
            <Grid>
                <DockPanel x:Name="WeekContent">
                    <DockPanel DockPanel.Dock="Top" Background="{DynamicResource SurfaceBackgroundBrush}" Margin="0,0,0,4">
                        <Button x:Name="CurrentRunButton" DockPanel.Dock="Right"
                                Visibility="Collapsed" Margin="8,2,4,2" MinWidth="200" MaxWidth="360"
                                Height="28" Padding="0" Click="CurrentRunButton_Click"
                                ToolTip="打开任务执行窗口"
                                ToolTipService.InitialShowDelay="100">
                            <Grid>
                                <ProgressBar x:Name="CurrentRunBar" Height="28" Minimum="0" Maximum="1800"
                                             BorderThickness="0" Background="Transparent"/>
                                <TextBlock x:Name="CurrentRunText"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Margin="10,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="当前执行："/>
                            </Grid>
                        </Button>
                        <WrapPanel>
                            <Button Content="新建任务" Click="NewTask_Click"/>
                            <Button Content="删除" Click="DeleteWeekSpan_Click"/>
                            <Button Content="奖励 / 愿望单…" Click="OpenRewardWish_Click"/>
                            <CheckBox x:Name="TaskArchivedBox" Content="显示已归档内容" VerticalAlignment="Center"
                                      Checked="TaskArchived_Changed" Unchecked="TaskArchived_Changed"/>
                            <TextBlock x:Name="ScheduleWalletText" VerticalAlignment="Center" Margin="12,0,8,4"
                                       FontWeight="SemiBold" Cursor="Hand"
                                       ToolTip="点击调整奖券数量 / 愿望单额度"
                                       ToolTipService.InitialShowDelay="100"
                                       MouseLeftButtonUp="ScheduleWallet_Click"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="当前奖券数量：0 · 愿望单额度：0"/>
                            <TextBlock Text="拖入图片或 Ctrl+V 新建 · 长按列内拖选补记 · 右键笔记钉 · F1 聚焦 · F5 刷新"
                                       VerticalAlignment="Center" Margin="8,0,8,4"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </WrapPanel>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="TaskRailCol" Width="280" MinWidth="120"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel x:Name="TaskDock" Grid.Column="0" AllowDrop="True" Background="Transparent"
                                   Margin="0,0,0,0"
                                   PreviewDragOver="TaskDock_PreviewDragOver"
                                   Drop="TaskDock_Drop">
                            <ScrollViewer x:Name="TaskScroll" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <WrapPanel x:Name="TaskWrap" Margin="4"/>
                            </ScrollViewer>
                        </DockPanel>
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch" ShowsPreview="True"
                                      Background="{DynamicResource BorderSubtleBrush}"
                                      PreviewMouseLeftButtonUp="TaskRailSplitter_MouseUp"/>
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" MinHeight="120"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition x:Name="StatsRow" Height="28"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <ScrollViewer x:Name="WeekScroll" HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto"
                                              ScrollChanged="WeekScroll_ScrollChanged"
                                              PreviewMouseWheel="WeekScroll_PreviewMouseWheel">
                                    <Border x:Name="WeekHost" MinHeight="200" Margin="0,0,8,0"/>
                                </ScrollViewer>
                                <Button x:Name="GoToNowButton" Content="回到当前时间"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,8,16,0" Click="GoToNow_Click"
                                        Panel.ZIndex="2"/>
                            </Grid>
                            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center" ShowsPreview="True"
                                          Background="{DynamicResource BorderSubtleBrush}"
                                          ResizeDirection="Rows"
                                          PreviewMouseLeftButtonUp="StatsSplitter_MouseUp"/>
                            <DockPanel Grid.Row="2" x:Name="StatsPanel" Margin="0,0,8,4"
                                       Background="{DynamicResource SurfaceBackgroundBrush}">
                                <Border DockPanel.Dock="Top" Height="28" Cursor="Hand"
                                        Background="Transparent" MouseLeftButtonUp="StatsHeader_Click">
                                    <DockPanel Margin="6,0">
                                        <TextBlock x:Name="StatsExpandGlyph" DockPanel.Dock="Left"
                                                   Text="▸" Width="14" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button x:Name="StatsDays7" Content="近7天" Height="22" Padding="6,0"
                                                    Margin="0,0,4,0" Click="StatsDays_Click" Tag="7"/>
                                            <Button x:Name="StatsDays14" Content="近14天" Height="22" Padding="6,0"
                                                    Margin="0,0,4,0" Click="StatsDays_Click" Tag="14"/>
                                            <Button x:Name="StatsDays30" Content="近30天" Height="22" Padding="6,0"
                                                    Click="StatsDays_Click" Tag="30"/>
                                        </StackPanel>
                                        <TextBlock Text="日程块统计" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </DockPanel>
                                </Border>
                                <Grid x:Name="StatsBody" Visibility="Collapsed" Margin="4,0,4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1" Background="{DynamicResource WeekColumnBackgroundBrush}">
                                        <Canvas x:Name="StatsChartCanvas" ClipToBounds="True"
                                                SizeChanged="StatsChartCanvas_SizeChanged"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,4,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Width="14" Height="3" Background="#5B9BD5" VerticalAlignment="Center"/>
                                            <TextBlock Text=" 直接生产力" Margin="4,0,0,0" FontSize="11"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="14" Height="3" Background="#C0392B" VerticalAlignment="Center"/>
                                            <TextBlock Text=" 非直接生产力" Margin="4,0,0,0" FontSize="11"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="StatsHintText" Margin="0,10,0,0" FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="纵轴 0–16h；跨日按天切开；含失败，扣暂停。"/>
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Grid>
                    </Grid>
                </DockPanel>
                <local:OfflineOverlay x:Name="WeekOfflineOverlay" ConnectClick="TryConnectNoco_Click"/>
            </Grid>
</UserControl>
