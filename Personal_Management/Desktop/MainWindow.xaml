<Window x:Class="PersonalManagement.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="个人管理" Height="640" Width="1100"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="StatusText" Text=""/>
            </StatusBarItem>
        </StatusBar>
        <TabControl Margin="8">
            <TabItem x:Name="WeekTab" Header="日程记录">
                <Grid>
                    <DockPanel x:Name="WeekContent">
                        <DockPanel DockPanel.Dock="Top" Background="{DynamicResource SurfaceBackgroundBrush}" Margin="0,0,0,4">
                            <Button x:Name="CurrentRunButton" DockPanel.Dock="Right"
                                    Visibility="Collapsed" Margin="8,2,4,2" MinWidth="200" MaxWidth="360"
                                    Height="28" Padding="0" Click="CurrentRunButton_Click"
                                    ToolTip="打开任务执行窗口"
                                    ToolTipService.InitialShowDelay="100">
                                <Grid>
                                    <ProgressBar x:Name="CurrentRunBar" Height="28" Minimum="0" Maximum="1800"
                                                 BorderThickness="0" Background="Transparent"/>
                                    <TextBlock x:Name="CurrentRunText"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Margin="10,0" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="当前执行："/>
                                </Grid>
                            </Button>
                            <WrapPanel>
                                <Button Content="新建任务" Click="NewTask_Click"/>
                                <Button Content="删除" Click="DeleteWeekSpan_Click"/>
                                <Button Content="奖励 / 愿望单…" Click="OpenRewardWish_Click"/>
                                <CheckBox x:Name="TaskArchivedBox" Content="显示已归档内容" VerticalAlignment="Center"
                                          Checked="TaskArchived_Changed" Unchecked="TaskArchived_Changed"/>
                                <TextBlock x:Name="ScheduleWalletText" VerticalAlignment="Center" Margin="12,0,8,4"
                                           FontWeight="SemiBold" Cursor="Hand"
                                           ToolTip="点击调整奖券数量 / 愿望单额度"
                                           ToolTipService.InitialShowDelay="100"
                                           MouseLeftButtonUp="ScheduleWallet_Click"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="当前奖券数量：0 · 愿望单额度：0"/>
                                <TextBlock Text="拖入图片或 Ctrl+V 新建 · 长按列内拖选补记 · F1 聚焦 · F5 刷新"
                                           VerticalAlignment="Center" Margin="8,0,8,4"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </WrapPanel>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="TaskRailCol" Width="280" MinWidth="120"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel x:Name="TaskDock" Grid.Column="0" AllowDrop="True" Background="Transparent"
                                       Margin="0,0,0,0"
                                       PreviewDragOver="TaskDock_PreviewDragOver"
                                       Drop="TaskDock_Drop">
                                <ScrollViewer x:Name="TaskScroll" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <WrapPanel x:Name="TaskWrap" Margin="4"/>
                                </ScrollViewer>
                            </DockPanel>
                            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" ShowsPreview="True"
                                          Background="{DynamicResource BorderSubtleBrush}"
                                          PreviewMouseLeftButtonUp="TaskRailSplitter_MouseUp"/>
                            <Grid Grid.Column="2">
                                <ScrollViewer x:Name="WeekScroll" HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto"
                                              ScrollChanged="WeekScroll_ScrollChanged"
                                              PreviewMouseWheel="WeekScroll_PreviewMouseWheel">
                                    <Border x:Name="WeekHost" MinHeight="560" Margin="0,0,8,8"/>
                                </ScrollViewer>
                                <Button x:Name="GoToNowButton" Content="回到当前时间"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,8,16,0" Click="GoToNow_Click"
                                        Panel.ZIndex="2"/>
                            </Grid>
                        </Grid>
                    </DockPanel>
                    <Border x:Name="WeekOfflineOverlay" Visibility="Collapsed" Background="#CCFFFFFF" Panel.ZIndex="20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                            <TextBlock Text="NocoDB未连接，请配置NocoDB或将此页面功能设为不依赖NocoDB后重试"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,12"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Button Content="尝试连接 NocoDB" HorizontalAlignment="Center" Click="TryConnectNoco_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem x:Name="FavTab" Header="收藏夹">
                <Grid>
                    <DockPanel x:Name="FavDock" AllowDrop="True" Background="Transparent"
                               PreviewDragOver="FavDock_PreviewDragOver"
                               Drop="FavDock_Drop">
                        <WrapPanel DockPanel.Dock="Top" Background="{DynamicResource SurfaceBackgroundBrush}" Margin="0,0,0,4">
                            <Button Content="添加" Click="AddFavorite_Click"/>
                            <Button Content="复制图片" Click="CopyFavorite_Click"/>
                            <Button Content="HoneyView" Click="HoneyViewFavorite_Click"/>
                            <Button Content="导出所选" Click="ExportFavorites_Click"/>
                            <TextBlock Text="标签" VerticalAlignment="Center" Margin="8,0,4,4"/>
                            <ComboBox x:Name="FavTagBox" Width="140" SelectionChanged="FavTagBox_Changed"/>
                            <CheckBox x:Name="FavPrivateBox" Content="显示私密 tag" VerticalAlignment="Center"
                                      Checked="FavPrivate_Checked" Unchecked="FavPrivate_Unchecked"/>
                            <TextBlock Text="拖入图片或 Ctrl+V · F5 刷新" VerticalAlignment="Center" Margin="8,0,8,4"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </WrapPanel>
                        <ScrollViewer x:Name="FavScroll" VerticalScrollBarVisibility="Auto" SizeChanged="CardHost_SizeChanged">
                            <WrapPanel x:Name="FavWrap" Margin="8"/>
                        </ScrollViewer>
                    </DockPanel>
                    <Border x:Name="FavOfflineOverlay" Visibility="Collapsed" Background="#CCFFFFFF" Panel.ZIndex="20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                            <TextBlock Text="NocoDB未连接，请配置NocoDB或将此页面功能设为不依赖NocoDB后重试"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,12"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Button Content="尝试连接 NocoDB" HorizontalAlignment="Center" Click="TryConnectNoco_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem x:Name="WeightTab" Header="体重">
                <Grid>
                    <DockPanel x:Name="WeightDock">
                        <WrapPanel DockPanel.Dock="Top" Background="{DynamicResource SurfaceBackgroundBrush}" Margin="0,0,0,4">
                            <Button Content="记今天" Click="WeightToday_Click"/>
                            <Button Content="批量粘贴…" Click="WeightBatch_Click"/>
                            <Button Content="保存档案" Click="WeightSaveProfile_Click"/>
                            <TextBlock Text="F5 刷新" VerticalAlignment="Center" Margin="12,0,8,4"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </WrapPanel>
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <WrapPanel>
                                    <TextBlock Text="身高(cm)" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                    <TextBox x:Name="WeightHeightBox" Width="64" Margin="0,0,12,4"/>
                                    <TextBlock Text="年龄" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                    <TextBox x:Name="WeightAgeBox" Width="48" Margin="0,0,12,4"/>
                                    <TextBlock Text="性别" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                    <ComboBox x:Name="WeightSexBox" Width="80" Margin="0,0,12,4"/>
                                    <TextBlock Text="活动" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                    <ComboBox x:Name="WeightActivityBox" Width="120" Margin="0,0,12,4"/>
                                </WrapPanel>
                                <TextBlock x:Name="WeightStatsText" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                                <TextBlock Text="横向范围" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                <TextBox x:Name="WeightChartFromBox" Width="100" Margin="0,0,4,4"
                                         LostFocus="WeightChartRange_Changed"/>
                                <TextBlock Text="至" VerticalAlignment="Center" Margin="0,0,4,4"/>
                                <TextBox x:Name="WeightChartToBox" Width="100" Margin="0,0,8,4"
                                         LostFocus="WeightChartRange_Changed"/>
                                <Button Content="近30天" Click="WeightChartLast30_Click" Margin="0,0,8,4"/>
                                <Button Content="应用" Click="WeightChartRange_Changed" Margin="0,0,4,4"/>
                            </WrapPanel>
                            <Border Grid.Row="2" x:Name="WeightChartBorder"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    Background="{DynamicResource SurfaceBackgroundBrush}">
                                <Canvas x:Name="WeightChartCanvas" ClipToBounds="True"
                                        SizeChanged="WeightChartCanvas_SizeChanged"/>
                            </Border>
                        </Grid>
                    </DockPanel>
                    <Border x:Name="WeightOfflineOverlay" Visibility="Collapsed" Background="#CCFFFFFF" Panel.ZIndex="20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                            <TextBlock Text="NocoDB未连接，请配置NocoDB或将此页面功能设为不依赖NocoDB后重试"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,12"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Button Content="尝试连接 NocoDB" HorizontalAlignment="Center" Click="TryConnectNoco_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="界面">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Background="{DynamicResource SurfaceBackgroundBrush}" Margin="0,0,0,4">
                        <TextBlock Text="当前样式" VerticalAlignment="Center" Margin="8,0,4,4"/>
                        <ComboBox x:Name="ThemeBox" Width="180" SelectionChanged="ThemeBox_Changed"/>
                        <Button Content="另存为副本" Click="SaveThemeCopy_Click"/>
                        <Button Content="删除副本" Click="DeleteThemeCopy_Click"/>
                    </WrapPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SettingsHost" Margin="16"/>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <TabItem Header="设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ConfigHost" Margin="16"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
