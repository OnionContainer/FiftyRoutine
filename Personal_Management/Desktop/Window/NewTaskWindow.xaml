<Window x:Class="PersonalManagement.Desktop.NewTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建任务" Height="640" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" IsCancel="True" Click="Cancel_Click"/>
            <Button x:Name="OkButton" Content="创建" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="名称" VerticalAlignment="Center"/>
                <TextBox x:Name="TitleBox" Grid.Column="1" Margin="0,4"/>
                <TextBlock Text="类型" Grid.Row="1" VerticalAlignment="Center"/>
                <ComboBox x:Name="TypeBox" Grid.Row="1" Grid.Column="1" Margin="0,4" SelectionChanged="TypeBox_Changed"/>
                <TextBlock Text="奖励等级" Grid.Row="2" VerticalAlignment="Center"/>
                <ComboBox x:Name="LevelBox" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
                <TextBlock Text="日程记录块颜色" Grid.Row="3" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,4">
                    <Button DockPanel.Dock="Right" Content="取色…" Click="PickColor_Click"/>
                    <Border x:Name="ColorSwatch" Height="24" Margin="0,0,8,0"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"/>
                </DockPanel>
                <TextBlock Text="日程记录块样式" Grid.Row="4" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <ComboBox x:Name="PatternBox" Grid.Row="4" Grid.Column="1" Margin="0,4"
                          SelectionChanged="Pattern_Changed"/>
                <TextBlock Text="样式颜色" Grid.Row="5" VerticalAlignment="Center"/>
                <DockPanel Grid.Row="5" Grid.Column="1" Margin="0,4">
                    <Button DockPanel.Dock="Right" Content="取色…" Click="PickPatternColor_Click"/>
                    <Border x:Name="PatternColorSwatch" Height="24" Margin="0,0,8,0"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"/>
                </DockPanel>
                <TextBlock Text="样式预览" Grid.Row="6" VerticalAlignment="Center"/>
                <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,4">
                    <Button DockPanel.Dock="Right" Content="高级编辑…" Click="OpenStyleEditor_Click" Margin="8,0,0,0"/>
                    <Border x:Name="PatternPreview" Height="40"
                            CornerRadius="4" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            ClipToBounds="True"/>
                </DockPanel>
                <TextBlock Text="缩略图" Grid.Row="7" VerticalAlignment="Center"/>
                <DockPanel Grid.Row="7" Grid.Column="1" Margin="0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="ClearThumbButton" Content="取消缩略图" Click="ClearThumb_Click"
                                Margin="0,0,8,0" IsEnabled="False"/>
                        <Button Content="重新截取…" Click="RecropThumb_Click" Margin="0,0,8,0"/>
                        <Button Content="浏览…" Click="PickThumb_Click"/>
                    </StackPanel>
                    <Image x:Name="ThumbPreview" Height="48" Stretch="Uniform" HorizontalAlignment="Left"/>
                </DockPanel>
                <TextBlock Text="截止时间" Grid.Row="8" VerticalAlignment="Center"/>
                <TextBox x:Name="DueBox" Grid.Row="8" Grid.Column="1" Margin="0,4" ToolTip="可空。格式 2026-08-22 18:00"/>
                <TextBlock Text="提醒时间" Grid.Row="9" VerticalAlignment="Center"/>
                <TextBox x:Name="RemindBox" Grid.Row="9" Grid.Column="1" Margin="0,4" ToolTip="可空。格式 2026-08-22 18:00"/>
                <TextBlock Text="奖励要求时长" Grid.Row="10" VerticalAlignment="Center"/>
                <TextBox x:Name="MinutesBox" Grid.Row="10" Grid.Column="1" Margin="0,4" Text="30"
                         ToolTip="分钟。范围 1–1440。任务进行中的进度条按这个时长。"/>
                <CheckBox x:Name="OverflowBox" Grid.Row="11" Grid.Column="1" Margin="0,8,0,4"
                          Content="允许溢出进度"/>
                <CheckBox x:Name="ArchivedBox" Grid.Row="12" Grid.Column="1" Margin="0,4"
                          Content="已归档"/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
