<Window x:Class="PersonalManagement.Desktop.FavoriteAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加收藏" Height="560" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="2" Width="200" Height="200" HorizontalAlignment="Left"
                Background="{DynamicResource SurfaceBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1" Margin="0,0,0,12">
            <Grid>
                <TextBlock x:Name="PreviewPlaceholder" Text="图片" FontSize="18"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="PreviewImage" Stretch="Uniform"/>
            </Grid>
        </Border>
        <TextBlock Text="类型" Grid.Row="1" VerticalAlignment="Center"/>
        <ComboBox x:Name="KindBox" Grid.Row="1" Grid.Column="1" Margin="0,4" SelectionChanged="KindBox_Changed"/>
        <TextBlock Text="名称" Grid.Row="2" VerticalAlignment="Center"/>
        <TextBox x:Name="TitleBox" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
        <TextBlock Text="来源" Grid.Row="3" VerticalAlignment="Center"/>
        <TextBox x:Name="SourceBox" Grid.Row="3" Grid.Column="1" Margin="0,4"/>
        <TextBlock Text="标签" Grid.Row="4" VerticalAlignment="Center"/>
        <TextBox x:Name="TagsBox" Grid.Row="4" Grid.Column="1" Margin="0,4"
                 ToolTip="逗号分隔。以 * 开头的是私密 tag，例如 *私人"/>
        <CheckBox x:Name="PrivateBox" Grid.Row="5" Grid.Column="1" Content="整条标为私密" Margin="0,8"/>
        <TextBlock Text="文件" Grid.Row="6" VerticalAlignment="Center"/>
        <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,4">
            <Button DockPanel.Dock="Right" Content="浏览…" Click="PickFile_Click"/>
            <TextBlock x:Name="FileLabel" VerticalAlignment="Center" Text="（图片/视频文件）"/>
        </DockPanel>
        <TextBlock Text="缩略图" Grid.Row="7" VerticalAlignment="Center"/>
        <DockPanel Grid.Row="7" Grid.Column="1" Margin="0,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="重新截取…" Click="RecropThumb_Click" Margin="0,0,8,0"/>
                <Button Content="浏览…" Click="PickThumb_Click"/>
            </StackPanel>
            <TextBlock x:Name="ThumbLabel" VerticalAlignment="Center" Text="（链接/视频可选）"/>
        </DockPanel>
        <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" Click="Cancel_Click"/>
            <Button x:Name="OkButton" Content="添加" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
