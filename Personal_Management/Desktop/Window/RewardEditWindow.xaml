<Window x:Class="PersonalManagement.Desktop.RewardEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加奖励" Height="440" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="名称" VerticalAlignment="Center"/>
        <TextBox x:Name="TitleBox" Grid.Column="1" Margin="0,4"/>
        <TextBlock Text="类型" Grid.Row="1" VerticalAlignment="Center"/>
        <ComboBox x:Name="KindBox" Grid.Row="1" Grid.Column="1" Margin="0,4"
                  SelectionChanged="KindBox_Changed"/>
        <TextBlock x:Name="QuotaLabel" Text="额度" Grid.Row="2" VerticalAlignment="Center"/>
        <TextBox x:Name="QuotaBox" Grid.Row="2" Grid.Column="1" Margin="0,4" Text="0"
                 ToolTip="仅「愿望单额度」类型可填，抽中后增加愿望单额度"/>
        <TextBlock x:Name="TicketLabel" Text="奖券数量" Grid.Row="3" VerticalAlignment="Center"/>
        <TextBox x:Name="TicketBox" Grid.Row="3" Grid.Column="1" Margin="0,4" Text="1"
                 ToolTip="仅「奖券」类型可填，抽中后增加奖券数量"/>
        <TextBlock Text="概率 %" Grid.Row="4" VerticalAlignment="Center"/>
        <TextBox x:Name="ProbBox" Grid.Row="4" Grid.Column="1" Margin="0,4" Text="0"
                 ToolTip="固定百分比 0–100。基础奖励不用填，会按 100%−其余自动算。"/>
        <CheckBox x:Name="BaseBox" Grid.Row="5" Grid.Column="1" Margin="0,8,0,4"
                  Content="基础奖励（动态概率 = 100% − 其余）"
                  Checked="BaseBox_Changed" Unchecked="BaseBox_Changed"/>
        <TextBlock Text="缩略图" Grid.Row="6" VerticalAlignment="Center"/>
        <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="重新截取…" Click="RecropThumb_Click" Margin="0,0,8,0"/>
                <Button Content="浏览…" Click="PickThumb_Click"/>
            </StackPanel>
            <Image x:Name="ThumbPreview" Height="48" Stretch="Uniform" HorizontalAlignment="Left"/>
        </DockPanel>
        <CheckBox x:Name="ArchivedBox" Grid.Row="7" Grid.Column="1" Margin="0,8,0,4" Content="已归档"/>
        <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" Click="Cancel_Click"/>
            <Button x:Name="OkButton" Content="保存" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
