<Window x:Class="PersonalManagement.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="个人管理 — 登录"
        Height="520" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <DockPanel Margin="16">
        <TextBlock x:Name="HintText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <StackPanel x:Name="ListPanel" DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="选择用户" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ListBox x:Name="UserList" Height="120" MouseDoubleClick="UserList_DoubleClick"/>
            <Button Content="进入所选用户" Margin="0,8,0,0" Height="32" Click="EnterSelected_Click"/>
        </StackPanel>
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                Padding="0,12,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="CreateTitle" Text="新增用户" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="用户名" Margin="0,0,0,4"/>
                    <TextBox x:Name="NameBox" Margin="0,0,0,8"/>
                    <TextBlock x:Name="NocoSectionHint" Text="使用 NocoDB 的服务（默认全不使用）" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <CheckBox x:Name="NocoBizBox" Content="业务（日程 / 任务 / 奖励）" Margin="0,2"
                              Checked="NocoFlag_Changed" Unchecked="NocoFlag_Changed"/>
                    <CheckBox x:Name="NocoFavBox" Content="收藏夹" Margin="0,2"
                              Checked="NocoFlag_Changed" Unchecked="NocoFlag_Changed"/>
                    <CheckBox x:Name="NocoWeightBox" Content="体重" Margin="0,2"
                              Checked="NocoFlag_Changed" Unchecked="NocoFlag_Changed"/>
                    <StackPanel x:Name="NocoFields" Margin="0,8,0,0" IsEnabled="False">
                        <TextBlock Text="NocoDB URL" Margin="0,0,0,2"/>
                        <TextBox x:Name="UrlBox" Margin="0,0,0,6"/>
                        <TextBlock Text="Email" Margin="0,0,0,2"/>
                        <TextBox x:Name="EmailBox" Margin="0,0,0,6"/>
                        <TextBlock Text="Password" Margin="0,0,0,2"/>
                        <PasswordBox x:Name="PasswordBox" Margin="0,0,0,6"/>
                        <TextBlock Text="ApiToken（可空）" Margin="0,0,0,2"/>
                        <TextBox x:Name="TokenBox" Margin="0,0,0,6"/>
                    </StackPanel>
                    <Button x:Name="CreateButton" Content="创建并进入" Height="36" Margin="0,12,0,0"
                            Click="Create_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
