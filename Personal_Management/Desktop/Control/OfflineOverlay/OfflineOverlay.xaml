<UserControl x:Class="PersonalManagement.Desktop.OfflineOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" Panel.ZIndex="20">
    <Border Background="#CCFFFFFF">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
            <TextBlock Text="NocoDB未连接，请配置NocoDB或将此页面功能设为不依赖NocoDB后重试"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,12"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <Button Content="尝试连接 NocoDB" HorizontalAlignment="Center" Click="Connect_Click"/>
        </StackPanel>
    </Border>
</UserControl>
